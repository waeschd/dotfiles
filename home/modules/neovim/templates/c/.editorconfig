root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
insert_final_newline = true

# Indentation
indent_style = space
indent_size = 2
tab_width = 2

# C/C++ specific rules
[*.{c,cpp,h,hpp,cc,cxx}]
indent_style = tab
indent_size = 8
tab_width = 8

# Optional: align with clang-format
max_line_length = 120

# Markdown & text files
[*.md]
trim_trailing_whitespace = false
max_line_length = off

